# Copy to .env and fill in. Every mode defaults to mock, so an empty .env still boots.

# --- Server ---
PORT=3000
# Base URL used in links the bot sends (swipe page). Your Railway/.tech URL in prod.
PUBLIC_URL=http://localhost:3000

# --- Database (Neon pooled connection string). Unset = migrations skipped. ---
DATABASE_URL=

# --- iMessage via Photon / spectrum-ts ---
# terminal = local fake chat in this terminal, imessage = real Photon line
SPECTRUM_PROVIDER=terminal
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The line people text, shown on the landing page + QR code (e.g. +15551234567)
BOT_PHONE=

# --- Capital One Nessie ---
# mock = in-memory fake, live = api.nessieisreal.com
NESSIE_MODE=mock
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# --- Gemini ---
# mock = canned roasts, live = Gemini API
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Jobs / demo ---
# How often the poller checks Nessie for new purchases (3000 for demo)
POLL_INTERVAL_MS=5000
# 1 = shortened cooldowns for live demos
DEMO_MODE=0
# Protects POST /admin/reset
DEMO_ADMIN_SECRET=changeme
